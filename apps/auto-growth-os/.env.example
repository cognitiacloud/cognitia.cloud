# Cognitia Auto Growth OS — environment template
# ----------------------------------------------------------------------------
# This is a DEMO. Every integration ships as a simulated Mock* adapter, so the
# app runs locally with NO external services and NONE of these values set.
#
# To go live, implement a real adapter against the matching interface in
# lib/adapters/types.ts, swap it in lib/adapters/index.ts, and provide the
# credentials below. Keep real secrets out of version control.

# Demo flag — set to "false" once real integrations are wired in.
NEXT_PUBLIC_DEMO_MODE=true

# --- WhatsApp Cloud API (lib/adapters/whatsapp.ts) --------------------------
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# --- CRM / DMS (lib/adapters/crm.ts) ----------------------------------------
CRM_API_BASE_URL=
CRM_API_KEY=

# --- Google Ads / Meta Ads reporting (lib/adapters/ads.ts) ------------------
# Read-only reporting. Ad SPEND is paid directly by the client in their own
# Google / Meta accounts and never flows through this app.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
META_ADS_ACCESS_TOKEN=
META_ADS_AD_ACCOUNT_ID=

# --- AI agent service (lib/adapters/ai.ts) ----------------------------------
# Drafts only — a human approval gate is enforced in code.
AI_AGENT_API_KEY=
AI_AGENT_MODEL=

# --- Email / SMS provider (lib/adapters/emailSms.ts) ------------------------
EMAIL_PROVIDER_API_KEY=
SMS_PROVIDER_API_KEY=
SMS_FROM_NUMBER=

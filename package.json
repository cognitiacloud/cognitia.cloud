{
  "name": "cognitia",
  "private": true,
  "version": "0.0.0",
  "description": "Cognitia monorepo",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "db:generate": "pnpm --filter @cognitia/db db:generate",
    "db:migrate": "pnpm --filter @cognitia/db db:migrate",
    "db:seed": "pnpm --filter @cognitia/db db:seed",
    "db:reset": "pnpm --filter @cognitia/db db:reset"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^20.14.0",
    "eslint": "^9.17.0",
    "prettier": "^3.3.3",
    "turbo": "^2.5.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}

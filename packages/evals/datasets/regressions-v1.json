          "employeeCount": 220,
          "region": "NA",
          "fitScore": 0.85,
          "timingScore": 0.8
        },
        {
          "id": "a1000000-0000-4000-8000-000000000002",
          "name": "Regression Account 2",
          "industry": "Retail",
          "employeeCount": 8,
          "region": "EU",
          "fitScore": 0.2,
          "timingScore": 0.2
        }
      ],
      "contacts": [],
      "expect": {
        "minProposals": 1,
        "allowedActionTypes": ["crm.task.create", "crm.note.create"],
        "mustTargetAccountIds": ["a1000000-0000-4000-8000-000000000001"],
        "mustNotTargetRefs": ["account:a1000000-0000-4000-8000-000000000002"],
        "idempotentRerun": true,

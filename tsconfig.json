{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "noEmit": true,
    "paths": {
      "@cognitia/core": ["packages/core/src/index.ts"],
      "@cognitia/core/*": ["packages/core/src/*"],
      "@cognitia/db": ["packages/db/src/index.ts"],
      "@cognitia/db/*": ["packages/db/src/*"],
      "@cognitia/agents": ["packages/agents/src/index.ts"],
      "@cognitia/agents/*": ["packages/agents/src/*"],
      "@cognitia/integrations": ["packages/integrations/src/index.ts"],
      "@cognitia/integrations/*": ["packages/integrations/src/*"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "apps/*/src/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "**/dist/**"]
}

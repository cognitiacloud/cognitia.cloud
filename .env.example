# ─── Mode ────────────────────────────────────────────────────────────────────
# When true, the app uses in-memory mock adapters (no Apify / vendor / LLM keys
# required) and is the default for local development.
MOCK_MODE=true
NODE_ENV=development

# ─── Database (Supabase Postgres) ────────────────────────────────────────────
# Local: a plain Postgres connection string works too.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sales_closer
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Voice vendor selection ──────────────────────────────────────────────────
# One of: mock | salescloser | vapi | retell | twilio
VENDOR_NAME=mock
SALESCLOSER_API_KEY=
SALESCLOSER_BASE_URL=https://api.salescloser.ai
SALESCLOSER_WEBHOOK_SECRET=

# ─── Apify ───────────────────────────────────────────────────────────────────
APIFY_TOKEN=

# ─── LLM (Anthropic default — reuses the hermes vision-skill provider pattern) ─
# One of: mock | anthropic | openai
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
# Model id is read from env, never hardcoded.
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=

# ─── Hermes vision-skill bridge (packages/vision) ────────────────────────────
# Path to the existing python skill; invoked over its MCP/CLI interface.
HERMES_VISION_SKILL_PATH=hermes/skills/vision-skill/vision_skill.py

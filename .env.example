# Cognitia GTM platform — example environment.
# Copy to .env and fill in. NEVER commit a real .env.
# Secrets are referenced, never logged (see docs/security-and-compliance.md).

# --- Database (Supabase Postgres) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cognitia
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- API service ---
API_PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# --- Integrations (placeholders; OAuth secrets stay server-side only) ---
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_WEBHOOK_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
EMAIL_PROVIDER_API_KEY=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# --- LLM provider ---
ANTHROPIC_API_KEY=

# --- Worker ---
WORKER_CONCURRENCY=4

# --- Live/outbound quarantine (CGD-001 / CGD-002). Deny-by-default. Secrets are not consent. ---
# Master gate plus the matching nested surface flag must BOTH be true.
# Do not set these true on this packet branch. Consented decision required later.
LIVE_OUTBOUND_EXPLICITLY_ALLOWED=false
LIVE_OUTBOUND_HUBSPOT=false
LIVE_OUTBOUND_SALESFORCE=false
LIVE_OUTBOUND_MIRA_WRITE=false
LIVE_OUTBOUND_EMAIL=false
LIVE_OUTBOUND_SMS=false
# CGD-002 inbound vendor GET / sync / OAuth-refresh (still deny-by-default).
LIVE_OUTBOUND_HUBSPOT_READ=false
LIVE_OUTBOUND_HUBSPOT_OAUTH_REFRESH=false
LIVE_OUTBOUND_SALESFORCE_READ=false

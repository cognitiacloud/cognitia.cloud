# Cognitia GTM platform — example environment.
# Copy to .env and fill in. NEVER commit a real .env.
# Secrets are referenced, never logged (see docs/security-and-compliance.md).

# --- Database (Supabase Postgres) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cognitia
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- API service ---
API_PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# --- Integrations (placeholders; OAuth secrets stay server-side only) ---
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_WEBHOOK_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
EMAIL_PROVIDER_API_KEY=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# --- LLM provider ---
ANTHROPIC_API_KEY=

# --- Worker ---
WORKER_CONCURRENCY=4

# --- Sales Closer: Apify ingestion (Phase 2) ---
# Default behavior is FIXTURE/MOCK only — no network. Live Apify calls require a
# token AND CLOSER_APIFY_ALLOW_NETWORK=true AND an allowlisted+approved+active
# source (source_risk not 'disallowed'; legal_review_required needs explicit
# human review). The token is never logged, persisted, or surfaced in errors.
APIFY_TOKEN=
CLOSER_APIFY_ALLOW_NETWORK=false
CLOSER_APIFY_LIVE_TESTS=false
CLOSER_APIFY_MAX_ITEMS=25
CLOSER_APIFY_DEFAULT_TIMEOUT_MS=30000

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cognitia.cloud/harness/state.schema.json",
  "title": "Goal loop state",
  "description": "Structured snapshot for one goal loop (goals/<slug>/state.json). Single source of truth for status, workers, checkpoint schedule, stop conditions, risks, and derived counters.",
  "type": "object",
  "required": ["schema_version", "goal", "status", "current_phase", "counters"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string" },
    "goal": {
      "type": "object",
      "required": ["slug", "title", "owner", "created_at"],
      "additionalProperties": false,
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "title": { "type": "string" },
        "owner": { "type": "string" },
        "created_at": { "type": "string" },
        "objective": { "type": "string" },
        "success_criteria": { "type": "array", "items": { "type": "string" } }
      }
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "paused", "blocked", "done", "aborted"]
    },
    "current_phase": { "type": "string" },
    "workers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "role", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "role": { "type": "string" },
          "assigned_at": { "type": "string" },
          "status": { "type": "string", "enum": ["active", "paused", "done"] }
        }
      }
    },
    "checkpoint_schedule": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "due_at": { "type": "string" },
          "next_due_at": { "type": "string" },
          "cadence": { "type": "string" },
          "status": { "type": "string", "enum": ["pending", "done", "skipped"] }
        }
      }
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["success_criteria_met", "max_runs", "deadline", "manual"]
          },
          "value": { "type": ["string", "number", "null"] },
          "triggered": { "type": "boolean" },
          "note": { "type": "string" }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "severity", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "med", "high", "critical"] },
          "likelihood": { "type": "string", "enum": ["low", "med", "high"] },
          "status": { "type": "string", "enum": ["open", "mitigated", "accepted", "closed"] },
          "mitigation": { "type": "string" },
          "owner": { "type": "string" },
          "opened_at": { "type": "string" }
        }
      }
    },
    "counters": {
      "type": "object",
      "required": ["runs", "artifacts", "decisions", "open_risks"],
      "additionalProperties": false,
      "properties": {
        "runs": { "type": "integer", "minimum": 0 },
        "artifacts": { "type": "integer", "minimum": 0 },
        "decisions": { "type": "integer", "minimum": 0 },
        "open_risks": { "type": "integer", "minimum": 0 }
      }
    },
    "last_checkpoint_at": { "type": ["string", "null"] },
    "next_checkpoint_at": { "type": ["string", "null"] },
    "updated_at": { "type": "string" }
  }
}

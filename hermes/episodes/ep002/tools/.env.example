# Cognitia EP002 LOCAL RUNNER — copy to .env and fill in.
# Everything here is OPTIONAL. With nothing set, the runner uses only existing
# local files and leaves missing proof clearly labeled PLACEHOLDER.

# ---- explicit asset paths (skip auto-search if set) -----------------
# AVATAR_VIDEO=/mnt/c/Users/smrai/Desktop/ep002_avatar.mp4   # HeyGen/facial talking-head
# VOICE_AUDIO=/mnt/c/Users/smrai/Desktop/ep002_vo.mp3        # ElevenLabs voice
# TELEGRAM_SHOT=/mnt/c/Users/smrai/Desktop/telegram.png      # delivery screenshot
# QC_SHOT=/mnt/c/Users/smrai/Desktop/qc.png                  # real QC scores screenshot

# ---- where to auto-search when a path above is not set --------------
# SEARCH_DIRS="$HOME/Downloads /mnt/c/Users/smrai/Downloads /mnt/c/Users/smrai/Desktop"

# ---- credit / outward-facing guards (default OFF) -------------------
ALLOW_CREDIT_CALLS=false      # true = allowed to call ElevenLabs TTS to make vo.mp3 (spends credits)
SEND_TELEGRAM=false           # true = send final to Telegram after approval (outward-facing)

# ---- ElevenLabs (only used if ALLOW_CREDIT_CALLS=true) --------------
# ELEVENLABS_API_KEY=sk-...
# ELEVENLABS_VOICE_ID=...

# ---- Telegram delivery (only used if SEND_TELEGRAM=true) ------------
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789

# ---- render quality for final ---------------------------------------
COG_FINAL_SCALE=2             # 1 = fast, 2 = crisp supersampled final

# NOTE: HeyGen is NOT auto-generated (async/credits). Supply AVATAR_VIDEO,
# or render your avatar in HeyGen and drop the file in. The runner never
# spends HeyGen credits.
